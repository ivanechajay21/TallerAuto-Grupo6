ROOT_USER=root
ROOT_PASSWORD=root
MYSQL_DATABASE=sigtm_db
MYSQL_USER=sigtm_user
MYSQL_PASSWORD=sigtm_password

# Cambia estos valores por los de tu sesión real (usa App Password de Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu.correo@gmail.com
MAIL_PASSWORD=tu_app_password

# URL pública del frontend (para los enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:3000

# Secreto JWT Base64 de al menos 32 bytes. Genera uno con:
# openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64_UNICO

# Desarrollo local: habilita datos y cuentas de demostración. En producción: false.
SEED_DATA=true
# true: el backend genera el Excel del Centro de Reportes con Apache POI.
# false: se conserva la generación local con la librería xlsx del frontend.
USE_APACHE_POI=false
# Orígenes separados por coma autorizados a consumir el API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
