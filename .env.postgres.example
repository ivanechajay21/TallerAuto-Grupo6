# Configuración local para docker-compose.postgres.dev.yml.
POSTGRES_DB=sigtm_db
POSTGRES_USER=sigtm_user
POSTGRES_PASSWORD=sigtm_password
PGADMIN_DEFAULT_EMAIL=admin@sigtm.local
PGADMIN_DEFAULT_PASSWORD=admin_dev_password

# Secreto Base64 de al menos 32 bytes. Generar uno distinto fuera de desarrollo.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_BASE64_UNICO
SEED_DATA=true
USE_APACHE_POI=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
